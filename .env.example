# Environment variables declared in this file are automatically made available to Prisma and Next.js.
# See the documentation for more detail: https://pris.ly/d/prisma-schema#accessing-environment-variables-from-the-schema

# PostgreSQL Database Connection URL
DATABASE_URL="postgresql://postgres:password@localhost:5432/lms_platform?schema=public"

# Node Environment
NODE_ENV="development"

# NextAuth Configuration
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-generated-nextauth-secret-key"
